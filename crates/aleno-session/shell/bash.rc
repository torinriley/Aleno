# Aleno shell integration (bash >= 4.4 for command blocks). Used via --rcfile; emulates a login shell first.
if [ -n "$ALENO_BASH_LOGIN" ]; then
  unset ALENO_BASH_LOGIN
  [ -r /etc/profile ] && . /etc/profile
  for _aleno_f in "$HOME/.bash_profile" "$HOME/.bash_login" "$HOME/.profile"; do
    if [ -r "$_aleno_f" ]; then . "$_aleno_f"; break; fi
  done
  unset _aleno_f
fi
if [ "${ALENO_SHELL_INTEGRATION:-1}" != 0 ] && [ -z "$_aleno_loaded" ]; then
  _aleno_loaded=1
  _aleno_ran=0
  __aleno_pc() {
    local ret=$?
    if [ "$_aleno_ran" = 1 ]; then printf '\e]133;D;%s\a' "$ret"; _aleno_ran=0; fi
    printf '\e]7;file://%s%s\a\e]133;A\a' "${HOSTNAME}" "${PWD// /%20}"
    return $ret
  }
  __aleno_c() {
    _aleno_ran=1
    local c; c=$(HISTTIMEFORMAT= builtin history 1 2>/dev/null)
    c="${c#"${c%%[![:space:]]*}"}"; c="${c#*[[:space:]]}"; c="${c#"${c%%[![:space:]]*}"}"; c="${c//[[:cntrl:]]/ }"
    printf '\e]133;C;cmd=%s\a' "${c:0:512}"
  }
  case "$PROMPT_COMMAND" in
    *__aleno_pc*) ;;
    *) PROMPT_COMMAND="__aleno_pc${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
  esac
  # PS0 is printed after the command line is accepted (bash >= 4.4).
  PS0="${PS0}\$(__aleno_c)"
fi
