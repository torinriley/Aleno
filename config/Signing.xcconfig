// Code signing for local builds. Defaults to ad-hoc signing so anyone can build without an Apple developer account.
// To sign with your own certificate, create config/Signing.local.xcconfig (git-ignored) containing for example:
//   CODE_SIGN_IDENTITY = Apple Development
//   DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
